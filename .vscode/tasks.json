{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Release)",
            "type": "process",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "MiniBotLauncher.sln",
                "-t:Build",
                "-p:Configuration=Release",
                "-restore"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build (Debug)",
            "type": "process",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "MiniBotLauncher.sln",
                "-t:Build",
                "-p:Configuration=Debug",
                "-restore"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Publish (Single EXE)",
            "type": "process",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "MiniBotLauncher\\MiniBotLauncher.csproj",
                "-t:Publish",
                "-p:Configuration=Release",
                "-p:PublishDir=..\\publish\\"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": ".\\MiniBotLauncher\\bin\\Release\\net8.0-windows\\MiniBotLauncher.exe",
            "group": "none",
            "dependsOn": "Build (Release)",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "MiniBotLauncher.sln",
                "-t:Clean"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
